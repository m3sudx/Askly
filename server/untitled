#!/usr/bin/env bash
# Usage: source ~/get-token.sh
EMAIL="mesud3818@gmail.com"
PUBLISHABLE_KEY="sb_publishable_2eMh8pcqKpdheRCZzBGhxQ_cEADI2mF"
SUPABASE_URL="https://rmkajaojozzttgrfvbxm.supabase.co"

read -rsp "Password: " PW; echo
TOKEN=$(curl -s -X POST "$SUPABASE_URL/auth/v1/token?grant_type=password" \
  -H "apikey: $PUBLISHABLE_KEY" -H "Content-Type: application/json" \
  -d "$(jq -n --arg e "$EMAIL" --arg p "$PW" '{email:$e,password:$p}')" | jq -r .access_token)
unset PW

echo "token length: ${#TOKEN}"
export TOKEN